<Window x:Class="LlamaCppLoader.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Llama.cpp Server Loader" Height="800" Width="1000"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5"
        KeyDown="Window_KeyDown">
    <Window.InputBindings>
        <KeyBinding Key="S" Modifiers="Ctrl" Command="{Binding SaveProfileCommand}"/>
        <KeyBinding Key="F5" Command="{Binding StartServerCommand}"/>
        <KeyBinding Key="F5" Modifiers="Ctrl" Command="{Binding StopServerCommand}"/>
        <KeyBinding Key="L" Modifiers="Ctrl" Command="{Binding ClearConsoleCommand}"/>
    </Window.InputBindings>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="200"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Version Info Bar -->
        <Border Grid.Row="0" Background="#E3F2FD" BorderBrush="#2196F3" BorderThickness="0,0,0,2" Padding="10,5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock x:Name="VersionInfoTextBlock" Text="检测版本中..." VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock x:Name="UpdateAvailableTextBlock" Visibility="Collapsed" VerticalAlignment="Center" Margin="10,0,0,0">
                        <Hyperlink x:Name="UpdateLink" Click="UpdateLink_Click">
                            <Run Text="🔔 发现新版本！点击查看"/>
                        </Hyperlink>
                    </TextBlock>
                </StackPanel>
                <Button x:Name="RefreshVersionButton" Grid.Column="1" Content="🔄 刷新版本"
                        Click="RefreshVersion_Click" Padding="8,5" Margin="5,0" MinWidth="90"/>
            </Grid>
        </Border>

        <!-- Configuration Section -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="10">
                <!-- Server Configuration -->
                <GroupBox Header="服务器配置 (Server Configuration)">
                    <GroupBox.HeaderTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" FontWeight="Bold"/>
                        </DataTemplate>
                    </GroupBox.HeaderTemplate>
                    <StackPanel>
                        <TextBlock Text="llama-server.exe Path (服务器路径):"
                                   ToolTip="llama.cpp 的服务器程序路径。下载最新版本请访问: https://github.com/ggml-org/llama.cpp/releases"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="ServerPathTextBox" Grid.Column="0"
                                     ToolTip="选择 llama-server.exe 文件。程序会自动检测版本号。&#x0a;💡 提示：可以直接拖放文件到此处"
                                     AllowDrop="True"
                                     PreviewDragOver="ServerPath_PreviewDragOver"
                                     Drop="ServerPath_Drop"/>
                            <Button Content="Browse..." Grid.Column="1" Click="BrowseServerPath_Click"
                                    ToolTip="浏览选择 llama-server.exe" Padding="8,5" Margin="5,0,0,5" MinWidth="90"/>
                        </Grid>

                        <TextBlock Text="Model Path (模型文件路径):"
                                   ToolTip="GGUF 格式的模型文件。推荐使用量化版本如 Q4_K_M, Q5_K_M 等以平衡性能和质量。"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="ModelPathTextBox" Grid.Column="0"
                                     ToolTip="选择 .gguf 模型文件。量化级别：Q4_K_M=快速省显存, Q5_K_M=平衡, Q6_K=高质量, Q8_0=接近原始&#x0a;💡 提示：可以直接拖放文件到此处"
                                     AllowDrop="True"
                                     PreviewDragOver="ModelPath_PreviewDragOver"
                                     Drop="ModelPath_Drop"/>
                            <Button Content="Browse..." Grid.Column="1" Click="BrowseModelPath_Click"
                                    ToolTip="浏览选择 .gguf 模型文件" Padding="8,5" Margin="5,0,0,5" MinWidth="90"/>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Port (端口号):"
                                           ToolTip="服务器监听端口。默认 8080，可修改为任意未占用端口。"
                                           ToolTipService.InitialShowDelay="100"/>
                                <TextBox x:Name="PortTextBox" Text="8080"
                                         ToolTip="服务器 HTTP 端口。启动后通过 http://localhost:端口号 访问。"
                                         ToolTipService.InitialShowDelay="100"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="GPU Layers (GPU层数):"
                                           ToolTip="加载到 GPU 的模型层数。999 表示全部加载到 GPU，0 表示使用 CPU。"
                                           ToolTipService.InitialShowDelay="100"/>
                                <TextBox x:Name="NGpuLayersTextBox" Text="999"
                                         ToolTip="建议值：&#x0a;• 999 - 全部加载到GPU (推荐，性能最佳)&#x0a;• 0 - 仅使用CPU&#x0a;• 20-40 - 部分GPU加载（显存不足时）"
                                         ToolTipService.InitialShowDelay="100"/>
                            </StackPanel>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <CheckBox x:Name="JinjaCheckBox" Content="Enable Jinja (启用Jinja模板)" IsChecked="True" Margin="5,15,5,5"
                                          ToolTip="必须开启！Qwen3 等新模型需要 Jinja 模板支持才能正确处理 system/user/assistant 角色。&#x0a;不开启可能导致：不听 system 指令、输出格式异常、无限循环等问题。"
                                          ToolTipService.InitialShowDelay="100"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </GroupBox>

                <!-- Context Configuration -->
                <GroupBox Header="上下文配置 (Context Configuration)">
                    <GroupBox.HeaderTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" FontWeight="Bold"/>
                        </DataTemplate>
                    </GroupBox.HeaderTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Context Size (上下文长度):"
                                       ToolTip="模型一次能处理的最大 Token 数。越大能读更长代码/日志，但占显存更多。&#x0a;推荐：普通聊天 16k-32k，代码审计 64k-96k，大型分析 128k+"
                                       ToolTipService.InitialShowDelay="100"/>
                            <TextBox x:Name="CtxSizeTextBox" Text="65536"
                                     ToolTip="建议值：&#x0a;• 16384 - 普通对话&#x0a;• 32768 - 代码生成&#x0a;• 65536 - CTF/代码审计 (推荐)&#x0a;• 98304 - 大型源码分析&#x0a;• 131072+ - 需要更多显存"
                                     ToolTipService.InitialShowDelay="100"/>

                            <TextBlock Text="Batch Size (批处理大小):"
                                       ToolTip="一次提交给 GPU 处理的 Token 数量。越大 Prompt 处理越快，但占显存越高。&#x0a;推荐：16G显存=512, 24G显存=1024-2048, 48G显存=4096"
                                       ToolTipService.InitialShowDelay="100"/>
                            <TextBox x:Name="BatchSizeTextBox" Text="1024"
                                     ToolTip="建议值：&#x0a;• 512 - 16G 显存&#x0a;• 1024 - 24G 显存 (RTX 5090推荐)&#x0a;• 2048 - 24G 显存高性能&#x0a;• 4096 - 48G+ 显存"
                                     ToolTipService.InitialShowDelay="100"/>

                            <TextBlock Text="UBatch Size (微批处理大小):"
                                       ToolTip="GPU 实际执行时的小批次大小，控制显存峰值和计算效率。&#x0a;通常设为 Batch Size 的 1/4 到 1/2"
                                       ToolTipService.InitialShowDelay="100"/>
                            <TextBox x:Name="UBatchSizeTextBox" Text="256"
                                     ToolTip="建议值：&#x0a;• 128 - 显存紧张时&#x0a;• 256 - 标准配置 (推荐)&#x0a;• 512 - 高端显卡"
                                     ToolTipService.InitialShowDelay="100"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Cache Type K (Key缓存量化):"
                                       ToolTip="KV Cache 中 Key 的精度。影响长上下文显存占用。&#x0a;f16=最高质量最高显存, q8_0=平衡 (推荐), q4_0=最省显存"
                                       ToolTipService.InitialShowDelay="100"/>
                            <ComboBox x:Name="CacheTypeKComboBox" SelectedIndex="1"
                                      ToolTip="建议：&#x0a;• f16 - 最佳质量，高显存&#x0a;• q8_0 - 质量接近f16，显存减半 (推荐)&#x0a;• q4_0 - 128k上下文或显存紧张时"
                                      ToolTipService.InitialShowDelay="100">
                                <ComboBoxItem Content="f16"/>
                                <ComboBoxItem Content="q8_0"/>
                                <ComboBoxItem Content="q4_0"/>
                            </ComboBox>

                            <TextBlock Text="Cache Type V (Value缓存量化):"
                                       ToolTip="KV Cache 中 Value 的精度。通常与 Cache Type K 保持一致。"
                                       ToolTipService.InitialShowDelay="100"/>
                            <ComboBox x:Name="CacheTypeVComboBox" SelectedIndex="1"
                                      ToolTip="建议：&#x0a;• f16 - 最佳质量&#x0a;• q8_0 - 推荐，与K保持一致&#x0a;• q4_0 - 极限省显存"
                                      ToolTipService.InitialShowDelay="100">
                                <ComboBoxItem Content="f16"/>
                                <ComboBoxItem Content="q8_0"/>
                                <ComboBoxItem Content="q4_0"/>
                            </ComboBox>

                            <TextBlock Text="Flash Attention (快速注意力):" Margin="5,5,5,0"
                                       ToolTip="必须开启！优化 Attention 计算，大幅降低显存占用并提高速度。&#x0a;如果显卡支持，强烈建议始终启用。"
                                       ToolTipService.InitialShowDelay="100"/>
                            <CheckBox x:Name="FlashAttnCheckBox" Content="启用 Flash Attention" IsChecked="True" Margin="5,2,5,5"
                                      ToolTip="必须开启！优化 Attention 计算，大幅降低显存占用并提高速度。&#x0a;效果：速度提升 2-3 倍，显存占用减少 40-60%"
                                      ToolTipService.InitialShowDelay="100"/>
                        </StackPanel>
                    </Grid>
                </GroupBox>

                <!-- Sampling Parameters -->
                <GroupBox Header="采样参数 (Sampling Parameters)">
                    <GroupBox.HeaderTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" FontWeight="Bold"/>
                        </DataTemplate>
                    </GroupBox.HeaderTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Temperature (温度):"
                                       ToolTip="控制输出的随机性和创造性。值越低越确定，越高越随机。"
                                       ToolTipService.InitialShowDelay="100"/>
                            <TextBox x:Name="TempTextBox" Text="0.40"
                                     ToolTip="建议值：&#x0a;• 0.2-0.3 - 代码生成&#x0a;• 0.3-0.4 - CTF/代码审计 (推荐)&#x0a;• 0.4-0.7 - 普通对话&#x0a;• 0.7-1.0 - 创意写作&#x0a;• 1.0+ - 非常随机"
                                     ToolTipService.InitialShowDelay="100"/>

                            <TextBlock Text="Top P (核采样):"
                                       ToolTip="从累积概率达到 P 的最小 token 集合中采样。控制输出的多样性。"
                                       ToolTipService.InitialShowDelay="100"/>
                            <TextBox x:Name="TopPTextBox" Text="0.88"
                                     ToolTip="建议值：&#x0a;• 0.85-0.90 - 代码生成 (推荐)&#x0a;• 0.90-0.95 - 普通对话&#x0a;• 0.95-0.98 - 创意任务"
                                     ToolTipService.InitialShowDelay="100"/>

                            <TextBlock Text="Top K (候选数量):"
                                       ToolTip="只考虑概率最高的 K 个 token。限制采样范围。"
                                       ToolTipService.InitialShowDelay="100"/>
                            <TextBox x:Name="TopKTextBox" Text="30"
                                     ToolTip="建议值：&#x0a;• 20-30 - 代码生成 (推荐30)&#x0a;• 25-40 - 普通对话&#x0a;• 50-80 - 创意任务"
                                     ToolTipService.InitialShowDelay="100"/>

                            <TextBlock Text="Min P (最小概率):"
                                       ToolTip="过滤掉概率低于阈值的 token，避免生成低质量输出。"
                                       ToolTipService.InitialShowDelay="100"/>
                            <TextBox x:Name="MinPTextBox" Text="0.05"
                                     ToolTip="建议值：&#x0a;• 0.03-0.05 - 代码生成&#x0a;• 0.05-0.08 - 普通对话 (推荐0.05)&#x0a;• 0.08-0.10 - 严格控制"
                                     ToolTipService.InitialShowDelay="100"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Repeat Penalty (重复惩罚):"
                                       ToolTip="惩罚重复出现的 token，防止死循环和无限重复。&#x0a;重要：防止模型陷入循环输出！"
                                       ToolTipService.InitialShowDelay="100"/>
                            <TextBox x:Name="RepeatPenaltyTextBox" Text="1.08"
                                     ToolTip="建议值：&#x0a;• 1.05-1.08 - 代码生成 (推荐1.08)&#x0a;• 1.08-1.10 - 普通对话&#x0a;• 1.10-1.15 - CTF长答案&#x0a;• 1.15-1.30 - 强烈防重复&#x0a;⚠️ 过高会影响连贯性"
                                     ToolTipService.InitialShowDelay="100"/>

                            <TextBlock Text="Repeat Last N (重复检测窗口):"
                                       ToolTip="检查最近多少个 token 的重复。越大越能防止远距离重复。"
                                       ToolTipService.InitialShowDelay="100"/>
                            <TextBox x:Name="RepeatLastNTextBox" Text="1024"
                                     ToolTip="建议值：&#x0a;• 512 - 短对话&#x0a;• 1024 - CTF/代码审计 (推荐)&#x0a;• 2048 - 超长答案防循环"
                                     ToolTipService.InitialShowDelay="100"/>

                            <TextBlock Text="Frequency Penalty (频率惩罚):"
                                       ToolTip="根据 token 出现频率降低其概率，减少重复内容。"
                                       ToolTipService.InitialShowDelay="100"/>
                            <TextBox x:Name="FrequencyPenaltyTextBox" Text="0.00"
                                     ToolTip="建议值：&#x0a;• 0.00 - 代码生成 (推荐，不影响变量名)&#x0a;• 0.05-0.10 - 普通对话&#x0a;• 0.10-0.20 - 减少重复内容"
                                     ToolTipService.InitialShowDelay="100"/>

                            <TextBlock Text="Presence Penalty (存在惩罚):"
                                       ToolTip="鼓励使用新 token，增加输出多样性。"
                                       ToolTipService.InitialShowDelay="100"/>
                            <TextBox x:Name="PresencePenaltyTextBox" Text="0"
                                     ToolTip="建议值：&#x0a;• 0 - 代码生成/CTF (推荐)&#x0a;• 0-0.10 - 普通对话&#x0a;• 0.10-0.20 - 增加多样性"
                                     ToolTipService.InitialShowDelay="100"/>
                        </StackPanel>
                    </Grid>
                </GroupBox>

                <!-- Advanced Configuration -->
                <GroupBox Header="高级配置 (Advanced Configuration)">
                    <GroupBox.HeaderTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" FontWeight="Bold"/>
                        </DataTemplate>
                    </GroupBox.HeaderTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Parallel Slots (并发槽位数):"
                                       ToolTip="同时支持的并发请求数量。默认4个槽位，单人使用建议设为1以节省显存。"
                                       ToolTipService.InitialShowDelay="100"/>
                            <TextBox x:Name="ParallelTextBox" Text="1"
                                     ToolTip="建议值：&#x0a;• 1 - 单人使用 (推荐，节省显存)&#x0a;• 2-4 - 多人使用&#x0a;• 4+ - 高并发服务器&#x0a;⚠️ 每个槽位会占用额外显存"
                                     ToolTipService.InitialShowDelay="100"/>

                            <CheckBox x:Name="ReasoningPreserveCheckBox" Content="Reasoning Preserve (保留推理)" IsChecked="True" Margin="5"
                                      ToolTip="保留模型的内部推理过程 &lt;think&gt;...&lt;/think&gt;&#x0a;Qwen3.6 等支持思考链的模型建议开启。&#x0a;对 CTF/代码审计非常有用！"
                                      ToolTipService.InitialShowDelay="100"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <CheckBox x:Name="ApiKeyEnabledCheckBox" Content="启用 API Key 验证" Margin="5" Checked="ApiKeyEnabled_Changed" Unchecked="ApiKeyEnabled_Changed"
                                      ToolTip="开启后需要提供 API Key 才能访问服务器。&#x0a;本机使用可不开启，局域网使用建议开启。"
                                      ToolTipService.InitialShowDelay="100"/>

                            <TextBlock Text="API Key (接口密钥):"
                                       ToolTip="自定义的 API 密钥，客户端需要在 Authorization 头中提供。"
                                       ToolTipService.InitialShowDelay="100"/>
                            <TextBox x:Name="ApiKeyTextBox" Text="" IsEnabled="False"
                                     ToolTip="示例: mysecret123&#x0a;客户端调用时需要: Authorization: Bearer mysecret123&#x0a;只在启用 API Key 验证时生效"
                                     ToolTipService.InitialShowDelay="100"/>
                        </StackPanel>
                    </Grid>
                </GroupBox>

                <!-- Parameter Presets -->
                <GroupBox Header="参数预设 (Parameter Presets)">
                    <GroupBox.HeaderTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" FontWeight="Bold"/>
                        </DataTemplate>
                    </GroupBox.HeaderTemplate>
                    <StackPanel>
                        <TextBlock Text="快速应用推荐配置（不会改变服务器和模型路径）：" Margin="5,5,5,10" Foreground="#666"/>
                        <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Content="🎯 CTF/代码审计" Click="ApplyPreset_CTF" Padding="10,5" Margin="5" MinWidth="120"
                                    ToolTip="Context: 65536, Temp: 0.40, Repeat Penalty: 1.08&#x0a;适合长上下文分析和代码审计"/>
                            <Button Content="💬 普通对话" Click="ApplyPreset_Conversation" Padding="10,5" Margin="5" MinWidth="120"
                                    ToolTip="Context: 32768, Temp: 0.70, Top P: 0.95&#x0a;适合日常聊天对话"/>
                            <Button Content="💻 代码生成" Click="ApplyPreset_CodeGen" Padding="10,5" Margin="5" MinWidth="120"
                                    ToolTip="Context: 32768, Temp: 0.20, Top P: 0.85&#x0a;适合精确的代码生成任务"/>
                            <Button Content="✍️ 创意写作" Click="ApplyPreset_Creative" Padding="10,5" Margin="5" MinWidth="120"
                                    ToolTip="Context: 32768, Temp: 0.90, Repeat Penalty: 1.15&#x0a;适合小说、诗歌等创意内容"/>
                            <Button Content="📚 大上下文" Click="ApplyPreset_LargeContext" Padding="10,5" Margin="5" MinWidth="120"
                                    ToolTip="Context: 131072, Cache: q4_0&#x0a;适合超长文档分析（需要更多显存）"/>
                        </WrapPanel>
                    </StackPanel>
                </GroupBox>

                <!-- Profile Management -->
                <GroupBox Header="配置管理 (Profile Management)">
                    <GroupBox.HeaderTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" FontWeight="Bold"/>
                        </DataTemplate>
                    </GroupBox.HeaderTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="ProfileComboBox" Grid.Column="0" Margin="5" SelectionChanged="ProfileComboBox_SelectionChanged"/>
                        <Button Content="Save Profile" Grid.Column="1" Click="SaveProfile_Click" Padding="8,5" Margin="5" MinWidth="100"
                                ToolTip="保存当前配置 (Ctrl+S)"/>
                        <Button Content="Delete Profile" Grid.Column="2" Click="DeleteProfile_Click" Padding="8,5" Margin="5" MinWidth="110"/>
                        <Button Content="📤 Export" Grid.Column="3" Click="ExportProfile_Click" Padding="8,5" Margin="5" MinWidth="90"
                                ToolTip="导出当前配置到文件"/>
                        <Button Content="📥 Import" Grid.Column="4" Click="ImportProfile_Click" Padding="8,5" Margin="5" MinWidth="90"
                                ToolTip="从文件导入配置"/>
                    </Grid>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>

        <!-- Output Console -->
        <GroupBox Grid.Row="2" Header="控制台输出 (Console Output)" Margin="10,0,10,10">
            <GroupBox.HeaderTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding}" FontWeight="Bold"/>
                </DataTemplate>
            </GroupBox.HeaderTemplate>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBox x:Name="ConsoleOutput"
                         IsReadOnly="True"
                         TextWrapping="Wrap"
                         FontFamily="Consolas"
                         FontSize="11"
                         Background="#1E1E1E"
                         Foreground="#D4D4D4"
                         BorderThickness="0"/>
            </ScrollViewer>
        </GroupBox>

        <!-- Control Buttons -->
        <Border Grid.Row="3" Background="#FAFAFA" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0" Padding="10">
            <Border.Resources>
                <Style x:Key="ModernButtonStyle" TargetType="Button">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="8"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Opacity" Value="0.9"/>
                            <Setter Property="Cursor" Value="Hand"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Opacity" Value="0.8"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Border.Resources>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="StartButton" Content="▶ 启动服务器 (F5)" Click="StartServer_Click"
                        Background="#4CAF50" Foreground="White" FontWeight="SemiBold" Width="180" Height="44" Margin="8" FontSize="14"
                        Style="{StaticResource ModernButtonStyle}" BorderThickness="0"
                        ToolTip="Start Server (F5)"/>
                <Button x:Name="StopButton" Content="⏹ 停止服务器 (Ctrl+F5)" Click="StopServer_Click"
                        Background="#F44336" Foreground="White" FontWeight="SemiBold" Width="210" Height="44" Margin="8" FontSize="14" IsEnabled="False"
                        Style="{StaticResource ModernButtonStyle}" BorderThickness="0"
                        ToolTip="Stop Server (Ctrl+F5)"/>
                <Button x:Name="TestButton" Content="🧪 测试连接" Click="TestConnection_Click"
                        Background="#2196F3" Foreground="White" FontWeight="SemiBold" Width="150" Height="44" Margin="8" FontSize="14" IsEnabled="False"
                        Style="{StaticResource ModernButtonStyle}" BorderThickness="0"
                        ToolTip="Test Connection"/>
                <Button Content="🗑 清空日志 (Ctrl+L)" Click="ClearOutput_Click" Width="180" Height="44" Margin="8" FontSize="14"
                        Background="#757575" Foreground="White" FontWeight="SemiBold"
                        Style="{StaticResource ModernButtonStyle}" BorderThickness="0"
                        ToolTip="Clear Console (Ctrl+L)"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
