<Window x:Class="LlamaCppLoader.SaveProfileDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Save Profile" Height="220" Width="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F5F5F5"
        SizeToContent="Height">
    <Window.Resources>
        <Style x:Key="ModernButtonStyle" TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.9"/>
                    <Setter Property="Cursor" Value="Hand"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Opacity" Value="0.8"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Profile Name:" Margin="0,0,0,10" FontSize="14" FontWeight="SemiBold"/>
        <TextBox x:Name="ProfileNameTextBox" Grid.Row="1" Padding="10" FontSize="13" Height="38"
                 BorderThickness="1" BorderBrush="#CCCCCC"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,25,0,0">
            <Button Content="保存" Width="110" Height="38" IsDefault="True" Click="Save_Click" Margin="0,0,12,0"
                    Background="#4CAF50" Foreground="White" FontWeight="SemiBold" FontSize="14"
                    Style="{StaticResource ModernButtonStyle}"
                    ToolTip="Save (保存配置)"/>
            <Button Content="取消" Width="110" Height="38" IsCancel="True" Click="Cancel_Click" FontSize="14"
                    Background="#E0E0E0" Foreground="#333333" FontWeight="SemiBold"
                    Style="{StaticResource ModernButtonStyle}"
                    ToolTip="Cancel (取消)"/>
        </StackPanel>
    </Grid>
</Window>
