# Auto detect text files and perform LF normalization
* text=auto

# Windows-specific files
*.bat text eol=crlf
*.cmd text eol=crlf

# Source code
*.cs text eol=crlf
*.xaml text eol=crlf
*.csproj text eol=crlf
*.sln text eol=crlf

# Documentation
*.md text eol=lf
*.txt text eol=lf

# JSON
*.json text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.exe binary
*.dll binary
